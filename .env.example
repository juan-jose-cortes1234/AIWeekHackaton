# Plantilla versionada. Copiar a .env y completar. NUNCA versionar .env.

# --- Equipo -------------------------------------------------------------------
TEAM_NAME=

# --- Juez de texto libre (SOLO para scripts/evaluate.py --ragas) --------------
# Llave entregada en la sesion inaugural. No la usa el sistema RAG.
OPENROUTER_API_KEY=

# --- Corpus -------------------------------------------------------------------
# Carpeta con fuentes.csv y los documentos crudos (puede ser una carpeta de
# OneDrive sincronizada). Ruta absoluta o relativa a la raiz del repo.
CORPUS_RAW_DIR=./corpus_raw
CORPUS_OUT_DIR=./build/corpus
INDEX_DIR=./build/indice
# Origen del corpus: auto | nube | local
#   auto  -> nube si CORPUS_ZIP_URL tiene valor; si no, local (CORPUS_RAW_DIR)
CORPUS_SOURCE=auto
# Enlace publico al zip (corpus procesado + indice + LICENSE). Sirven enlaces
# de compartir de Google Drive, OneDrive, Dropbox o Zenodo.
CORPUS_ZIP_URL=
# sha256 que imprime `python -m src.corpus.empaquetar` (congela el indice).
CORPUS_ZIP_SHA256=

# --- Encoder y reranker (licencia abierta) -----------------------------------
ENCODER_MODEL=BAAI/bge-m3
ENCODER_DEVICE=cpu
ENCODER_MAX_LENGTH=512
ENCODER_BATCH_SIZE=16
USE_RERANKER=1
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
TOP_K_PASAJES=10

# --- Decoder (licencia abierta, <= 8B, temperatura 0) -------------------------
# openai_compat: Ollama / vLLM / llama.cpp server / LM Studio
# llamacpp:      llama-cpp-python en proceso con un GGUF
DECODER_BACKEND=openai_compat
DECODER_BASE_URL=http://localhost:11434/v1
DECODER_MODEL=qwen3:8b
DECODER_API_KEY=local
DECODER_GGUF_PATH=
DECODER_TEMPERATURE=0
DECODER_SEED=42
DECODER_NUM_CTX=8192
DECODER_TIMEOUT_S=120

# --- Hugging Face (opcional, solo si hay limites de descarga) ----------------
HF_TOKEN=
