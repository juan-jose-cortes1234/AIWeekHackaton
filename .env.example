# Plantilla versionada. Copiar a .env y completar. NUNCA versionar .env.

# --- Equipo -------------------------------------------------------------------
TEAM_NAME=

# --- Juez de texto libre (SOLO para scripts/evaluate.py --ragas) --------------
# Llave entregada en la sesion inaugural. No la usa el sistema RAG.
OPENROUTER_API_KEY=

# --- Corpus -------------------------------------------------------------------
# Carpeta con fuentes.csv y los documentos crudos (puede ser una carpeta de
# OneDrive sincronizada). Ruta absoluta o relativa a la raiz del repo.
CORPUS_RAW_DIR=./corpus_raw
CORPUS_OUT_DIR=./build/corpus
INDEX_DIR=./build/indice
# Origen del corpus: auto | nube | local
#   auto  -> nube si CORPUS_ZIP_URL tiene valor; si no, local (CORPUS_RAW_DIR)
CORPUS_SOURCE=auto
# Enlace publico al zip (corpus procesado + indice + LICENSE). Sirven enlaces
# de compartir de Google Drive, OneDrive, Dropbox o Zenodo.
CORPUS_ZIP_URL=
# sha256 que imprime `python -m src.corpus.empaquetar` (congela el indice).
CORPUS_ZIP_SHA256=

# --- Encoder y reranker (licencia abierta) -----------------------------------
ENCODER_MODEL=BAAI/bge-m3
ENCODER_DEVICE=cpu
ENCODER_MAX_LENGTH=512
ENCODER_BATCH_SIZE=16
USE_RERANKER=1
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Candidatos que reordena el reranker (CPU: ~0,5 s por candidato; GPU: despreciable)
RERANK_CANDIDATOS=20
TOP_K_PASAJES=10
# Pasajes que lee el decoder. PALABRAS_POR_PASAJE=0 -> pasajes completos (flujo final).
# Un valor > 0 (p. ej. 180) recorta solo para acelerar pruebas en CPU.
PASAJES_PROMPT=10
PALABRAS_POR_PASAJE=0
# Recuperacion hibrida (RRF de denso + BM25; boosts sumados al puntaje RRF)
CANDIDATOS=50
RRF_K=60
PESO_DENSO=1.0
PESO_BM25=1.0
BOOST_AREA=0.002
BOOST_CUERPO=0.01
MAX_POR_ARTICULO=3
# Selección múltiple: puestos para la pregunta (el resto se reparte entre las opciones)
PUESTOS_PREGUNTA=4
PASAJES_POR_OPCION=2
RERANK_CANDIDATOS_OPCION=8
# 0 = elegir la letra primero y luego justificar y descartar (C-06); 1 = analizar cada opción antes de elegir (C-03)
MC_ANALISIS_PREVIO=0
# directo = elige con las opciones a la vista; abierta = primero responde sin ver las opciones y luego elige (C-08: +1 de 15 con casi el doble de latencia, descartado)
MC_MODO=directo
# Tokens de razonamiento de Qwen3 en selección múltiple (C-09): piensa antes de elegir, con este tope; 0 = sin razonamiento
MC_RAZONAMIENTO_TOKENS=0
# Consulta de cada opción: clave = texto de la opción + palabras clave de la pregunta (C-07); pregunta = pregunta completa + opción (C-03)
MC_CONSULTA_OPCION=clave
MC_PALABRAS_CLAVE=10
# Máximo de pasajes de un mismo documento (0 = sin tope); no aplica si la pregunta lo menciona
MAX_POR_DOCUMENTO=4
# Máximo de pasajes de documentos complementarios (config/documentos_complementarios.txt) entre los 10; 0 = sin tope (C-10)
MAX_COMPLEMENTARIOS=0
# Pasajes reservados a normas (artículos de leyes, códigos, decretos…) entre los 10, si hay candidatas;
# las búsquedas con menos pasajes reservan la parte proporcional; 0 = sin cupo (C-14)
CUOTA_NORMAS=4
# Citas renderizadas: pasajes usados por el modelo + pasajes con rerank >= UMBRAL_CITA
UMBRAL_CITA=0.5
MAX_REFERENCIAS=6
# Abstención (solo texto libre): abstencion=true si ningún pasaje supera esta pertinencia (reranker),
# es decir, si el corpus no da fundamento suficiente (requisito mínimo del Paso 4 del enunciado, C-19).
# Selección múltiple nunca se abstiene.
UMBRAL_ABSTENCION=0.025
UMBRAL_ABSTENCION_DENSO=0.35

# --- Decoder (licencia abierta, <= 8B, temperatura 0) -------------------------
# Todo corre en proceso con pesos de Hugging Face; no hay APIs ni servidores.
#   llamacpp:     llama-cpp-python + GGUF (CPU o GPU). Portatil y contenedor.
#   transformers: transformers + pesos originales (GPU recomendada: bf16 ~16 GB).
# Solo se aceptan modelos de la lista blanca de src/config.py (MODELOS_ABIERTOS).
DECODER_BACKEND=llamacpp
# Gemma 4 E4B (Apache-2.0, 7,996B parámetros) en GGUF oficial Q8_0 (C-15). Para volver a Qwen3-8B:
#   DECODER_MODEL=Qwen/Qwen3-8B  DECODER_GGUF_REPO=Qwen/Qwen3-8B-GGUF  DECODER_GGUF_FILE=Qwen3-8B-Q4_K_M.gguf
DECODER_MODEL=google/gemma-4-E4B-it
DECODER_GGUF_REPO=ggml-org/gemma-4-E4B-it-GGUF
DECODER_GGUF_FILE=gemma-4-E4B-it-Q8_0.gguf
# cpu | cuda
DECODER_DEVICE=cpu
DECODER_TEMPERATURE=0
DECODER_SEED=42
DECODER_NUM_CTX=8192
# Hilos de CPU para llamacpp (0 = automatico)
DECODER_THREADS=0

# --- Hugging Face (opcional, solo si hay limites de descarga) ----------------
HF_TOKEN=
